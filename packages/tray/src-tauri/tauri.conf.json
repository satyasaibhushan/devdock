{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devdock",
  "version": "0.0.0",
  "identifier": "com.devdock.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "trayIcon": {
      "id": "devdock",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "devdock",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
