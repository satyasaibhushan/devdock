<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.devdock.daemon</string>

  <!-- Filled in by install.sh: absolute paths to node + the built daemon. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__DAEMON__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DEVDOCK_PORT</key>
    <string>__PORT__</string>
    <key>DEVDOCK_ROOTS</key>
    <string>__ROOTS__</string>
    <!-- /usr/sbin so `lsof` resolves (move-here resolves the dev session's
         localhost port to its owning PID via lsof); /sbin for completeness. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Always-on: start at login, restart if it dies. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.devdock/daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.devdock/daemon.err.log</string>
</dict>
</plist>
